# Copy to .env.local and fill in. Validated at module load by lib/env.ts —
# a missing or malformed required var fails the production build rather than
# falling back to localhost in a deployed app.

# Backend REST base URL. REQUIRED for `yarn build` (NODE_ENV=production).
# In development it defaults to http://localhost:3000, so a fresh clone runs
# `yarn dev` with no setup.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Realtime chat WebSocket port. Optional, defaults to 3002. Only used when
# NEXT_PUBLIC_API_BASE_URL is http://, i.e. local development, where the API
# (3000) and the realtime server (3002) really are two ports on one machine.
NEXT_PUBLIC_CHAT_WS_PORT=3002

# Full origin of the realtime WebSocket server. OPTIONAL and usually unnecessary.
#
# The socket origin is derived from NEXT_PUBLIC_API_BASE_URL: an https:// API
# means something terminates TLS in front of the backend — a proxy, a tunnel, a
# load balancer, a PaaS — and all of those publish one origin and route the
# realtime server by path, so the socket is on that same origin. An http:// API
# is the local shape and gets the port above.
#
# Set this only when the realtime server genuinely lives somewhere else than the
# API. A trailing /ws and an http(s):// scheme are both corrected for, so pasting
# the full socket URL works.
#
#   NEXT_PUBLIC_CHAT_WS_URL=wss://realtime.example.com
NEXT_PUBLIC_CHAT_WS_URL=

# Sentry DSN (sentry.io > project > Settings > Client Keys). Optional — error
# reporting no-ops when unset. Public by design: a DSN only allows sending
# events, not reading them.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry environment tag, e.g. "production" on Railway. Optional, defaults to
# NODE_ENV — which is also "production" for a local `yarn build && yarn start`.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Source-map upload, build time only (NOT NEXT_PUBLIC — the token is a secret).
# Set on Railway so Sentry stack traces point at real source lines. Without the
# token the build skips generating source maps at all.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Meta App ID for the Facebook JS SDK. Required for Embedded Signup to load.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Embedded Signup config_id from the Meta App Dashboard.
NEXT_PUBLIC_FACEBOOK_ES_CONFIG_ID=

# Graph API version used by FB.init. Optional, defaults to v21.0.
NEXT_PUBLIC_FACEBOOK_GRAPH_VERSION=v21.0

# Support inbox shown on /dashboard/support. Optional — when unset the page
# says support contact isn't set up yet rather than offering a dead address.
# There is no ticketing backend; this is a mailto: target.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Escape hatch for recipient phone validation. Mirrors the backend's
# PHONE_VALIDATION_DISABLED — set both to "true" together, or neither.
# Only for the case it exists for: a carrier opens a new number range that the
# bundled libphonenumber-js metadata predates, so a real number is refused and
# the customer cannot send at all. Off, the E.164 shape check still applies and
# Meta decides the rest. Turn it back off once the dependency bump ships.
NEXT_PUBLIC_PHONE_VALIDATION_DISABLED=
